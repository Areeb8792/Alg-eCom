# ==============================================================================
# Algions E-Commerce Platform — Environment Configuration Template
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL
# Copy this file to .env for local runtime or configure in deployment secrets.
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
# Either provide DATABASE_URL or individual DB parameters:
DATABASE_URL=postgresql://algions_user:change_me_in_production@postgres:5432/algions_db
DB_HOST=postgres
DB_PORT=5432
DB_USER=algions_user
DB_PASSWORD=change_me_in_production
DB_NAME=algions_db
DB_POOL_MIN=2
DB_POOL_MAX=20

# Authentication & Security
JWT_SECRET=super_secret_jwt_signing_key_replace_with_strong_random_secret_in_prod
JWT_EXPIRES_IN=24h
CORS_ORIGIN=*

# Admin Bootstrap Account (Seeded on first migration/seed)
ADMIN_USERNAME=admin@algions.com
ADMIN_PASSWORD=change_me_admin_secure_password_2024

# Reverse Proxy (Nginx) & External Domain
SERVER_NAME=localhost
HTTP_PORT=80
HTTPS_PORT=443

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
