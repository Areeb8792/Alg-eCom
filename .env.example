# ==============================================================================
# Algions E-Commerce Platform — Environment Configuration Template
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL
# Copy this file to .env for local runtime or configure in deployment secrets.
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Database Configuration (PostgreSQL 16)
DB_HOST=postgres
DB_PORT=5432
DB_USER=algions_user
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD_IN_PRODUCTION
DB_NAME=algions_db
DB_POOL_MIN=2
DB_POOL_MAX=20
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Authentication & Security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_JWT_SECRET_MIN_64_CHARS
JWT_EXPIRES_IN=24h

# Cross-Origin Resource Sharing (CORS)
# In production (NODE_ENV=production), wildcard '*' is strictly forbidden and exact origin matching is enforced.
# Production example: CORS_ORIGIN=https://algions.com,https://api.algions.com,https://localhost
# Local development example (includes Vite dev port 3000, API 4000, and Nginx proxy 80/443):
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:80,http://127.0.0.1:80,http://localhost:4000,http://127.0.0.1:4000,https://localhost,https://127.0.0.1,https://algions.com

# Admin Bootstrap Account
ADMIN_USERNAME=admin@algions.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD_IN_PRODUCTION

# Reverse Proxy (Nginx) & External Domain
SERVER_NAME=localhost
HTTP_PORT=80
HTTPS_PORT=443

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Observability (Prometheus & Grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD_IN_PRODUCTION
GRAFANA_PORT=3001

# Container Registry & Image Versioning (GHCR)
# Uses immutable Git commit SHA or semver image tags for production releases
GHCR_OWNER=areeb8792
IMAGE_TAG=v1.0.1
API_IMAGE=ghcr.io/areeb8792/alg-ecom/api:v1.0.1
WEB_IMAGE=ghcr.io/areeb8792/alg-ecom/web:v1.0.1
