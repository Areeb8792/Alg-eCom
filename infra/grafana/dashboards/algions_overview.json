      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "orders_created_total",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          }
        }
      }
    },
