      "id": 2,
      "title": "PostgreSQL Connectivity",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "database_up",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            { "options": { "0": { "text": "DOWN" }, "1": { "text": "HEALTHY" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
