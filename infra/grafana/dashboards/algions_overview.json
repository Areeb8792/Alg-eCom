      "title": "API Uptime",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "process_uptime_seconds",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 60 }
            ]
